# Copiar a /etc/operacion-colombia.env (chmod 640, dueño root:ocolombia).
# NO versionar el archivo real: es configuración del servidor, no del repo.

# --- servicio ---
PORT=8081
HOST=127.0.0.1

# --- deploy por pull ---
OC_APP_DIR=/opt/operacion-colombia
OC_BRANCH=main
OC_SERVICE=operacion-colombia
OC_HEALTH_URL=http://127.0.0.1:8081/api/health

# Fallas de test toleradas antes de abortar el deploy. En 0: cualquier rojo revierte.
OC_ALLOWED_TEST_FAILURES=0

# --- escritura y explorer ---
# Sin este token, POST /api/explorer/register responde 503: la escritura falla cerrada.
# Generar con:  head -c 32 /dev/urandom | base64 | tr -d '/+=' | head -c 40
# EXPLORER_ADMIN_TOKEN=
# Portales Socrata extra permitidos (coma). El `domain` del usuario se interpola en la
# URL que consulta el servidor: fuera de la allowlist es SSRF, no una fuente nueva.
# EXPLORER_DOMAINS=

# --- IA ---
# Sin key, /api/ai/ask devuelve evidencia citada sin redacción (modo solo-recuperacion).
# ANTHROPIC_API_KEY=

# --- fuentes ---
# datos.gov.co sin token limita fuerte el rate de ingesta (CATALOGO §5, bloqueante 1).
# SOCRATA_APP_TOKEN=

# Capas del MapServer de la ANM a ingerir: "<idCapa>[:<slug>],…".
# Descubrilas primero:  node services/arcgis-explorer/cli.js "$ANM_SERVICE"
# Sin esta variable el dominio minería no se ingiere.
ANM_SERVICE=https://geo.anm.gov.co/webgis/rest/services/ANM/ServiciosANM/MapServer
# ANM_CAPAS=3:titulos-vigentes
# Generalización de geometría en grados; 0 = sin generalizar (recomendado para
# polígonos mineros, que son chicos y se colapsan con el valor de vías nacionales).
ANM_OFFSET=0
