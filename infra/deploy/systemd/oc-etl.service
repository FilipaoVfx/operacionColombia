[Unit]
Description=Operación Colombia — corrida ETL de todas las fuentes
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ocolombia
Group=ocolombia
WorkingDirectory=/opt/operacion-colombia
EnvironmentFile=/etc/operacion-colombia.env
# `tick` = scheduler (M5) + drenar la cola. NO usar `connectors run --all`: eso solo
# ingiere y se salta el fan-out que reconstruye vistas, entidades, grafo, search y bbox.
# El skip por etag/hash (M2) evita re-ingerir lo que no cambió.
ExecStart=/opt/operacion-colombia/infra/deploy/run-node.sh services/orchestrator/cli.js tick
TimeoutStartSec=3h
StandardOutput=journal
StandardError=journal
